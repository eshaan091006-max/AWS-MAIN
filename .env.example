# =================================================================
# Supabase — the only database. Required for event registration and
# the contact form. Dashboard > Project Settings > API
# =================================================================

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=""

# Anon / publishable key. Safe to expose: RLS restricts it to INSERT
# on event_registrations and contact_messages, with no read access.
SUPABASE_ANON_KEY=""

# OPTIONAL. Bypasses RLS, so it is server-only and must never be
# prefixed with NEXT_PUBLIC_. Only needed to READ submissions back.
SUPABASE_SERVICE_ROLE_KEY=""

# =================================================================
# Admin API
# =================================================================
# Shared secret guarding the admin-only routes (reading contact
# messages, creating/deleting events). Send as:
#   Authorization: Bearer <token>
# Leave unset and those routes stay disabled — they are never open.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Site URL, used for canonical metadata, robots.txt and sitemap.xml.
# Server-only: no NEXT_PUBLIC_ prefix, nothing in the browser reads it.
SITE_URL="https://sxcawsclub.vercel.app"

# Signs the admin session cookie. 32+ bytes of hex. Server-only.
ADMIN_SESSION_SECRET=""
