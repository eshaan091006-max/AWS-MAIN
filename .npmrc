# @react-three/drei 10 and @react-three/fiber 9 declare a peer of react@^19,
# while this project pins react 18. npm's strict peer resolution therefore
# fails the install outright, which is what broke the Vercel build.
#
# The pairing is deliberate and works: Next 15's App Router runs React 19
# internally regardless of the version pinned here, which is exactly why fiber
# 8 (built for React 18) had to be replaced with fiber 9 in the first place.
# The peer range is describing the React that Next actually supplies, not the
# one in this manifest.
#
# Every local install has used --legacy-peer-deps for this reason, so this file
# just makes CI resolve the same tree that has been running and tested here.
legacy-peer-deps=true
